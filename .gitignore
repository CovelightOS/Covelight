# OS cruft
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Godot 4
.godot/
.import/
export.cfg
*.translation
mono_crash.*.json
# export_presets.cfg is tracked, not ignored: CI (godot-export) needs it
# committed to run headless exports. It contains no machine-specific paths
# or credentials — just the Linux export preset.

# Rust
target/
**/*.rs.bk

# GDExtension build output (shell/rust/build_gdextension.sh copies here;
# platform-specific compiled binary, never committed -- see shell/README.md)
shell/addons/covelight_pck_verify/bin/

# Project signing keys. The PRIVATE key (.key) must NEVER be committed
# (docs/design/signing.md); public keys live embedded in
# covelight_crypto::TRUSTED_KEY_BYTES, not here. This whole directory is
# generated locally and kept offline by a maintainer.
.keys/

# Android
*.apk
*.aab
*.ap_
*.dex
.gradle/
local.properties
captures/
.externalNativeBuild/
.cxx/
build/

# Tauri (Node + Rust + platform bundles)
node_modules/
dist/
src-tauri/target/
*.dSYM

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / IDEs
.idea/
.vscode/
*.iml
