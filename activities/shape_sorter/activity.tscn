; Slots are Panels (a StyleBoxFlat gives them an outlined "hole" look, one
; per pair colour, tinted in code by activity.gd). Shapes are Draggables
; with a solid ColorRect fill. Both are pinned top-left (anchors_preset=0)
; and positioned entirely from code (_layout) — dragging needs free
; movement, which explicit `position` values keep simple. Scene positions
; below are rough placeholders so the editor preview isn't all stacked at
; the origin; _layout overrides them on load.

[sub_resource type="StyleBoxFlat" id="1"]
bg_color = Color(1, 1, 1, 0.15)
border_width_left = 6
border_width_top = 6
border_width_right = 6
border_width_bottom = 6
border_color = Color(1, 1, 1, 0.6)
corner_radius_top_left = 32
corner_radius_top_right = 32
corner_radius_bottom_right = 32
corner_radius_bottom_left = 32

