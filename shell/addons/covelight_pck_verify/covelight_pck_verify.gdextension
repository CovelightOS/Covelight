[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]

macos.debug = "res://addons/covelight_pck_verify/bin/libcovelight_pck_verify.dylib"
macos.release = "res://addons/covelight_pck_verify/bin/libcovelight_pck_verify.dylib"
linux.debug = "res://addons/covelight_pck_verify/bin/libcovelight_pck_verify.so"
linux.release = "res://addons/covelight_pck_verify/bin/libcovelight_pck_verify.so"
android.debug.arm64 = "res://addons/covelight_pck_verify/bin/android/arm64-v8a/libcovelight_pck_verify.so"
android.release.arm64 = "res://addons/covelight_pck_verify/bin/android/arm64-v8a/libcovelight_pck_verify.so"
android.debug.arm32 = "res://addons/covelight_pck_verify/bin/android/armeabi-v7a/libcovelight_pck_verify.so"
android.release.arm32 = "res://addons/covelight_pck_verify/bin/android/armeabi-v7a/libcovelight_pck_verify.so"
